<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://druzhinskaia.github.io/medtech"><bpmn:process id="Process" name="asis" isExecutable="false"><bpmn:laneSet id="Lanes"><bpmn:lane id="Lane_0" name="Расписание"><bpmn:flowNodeRef>N_start</bpmn:flowNodeRef><bpmn:flowNodeRef>N_list</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Контакт-центр"><bpmn:flowNodeRef>N_notice</bpmn:flowNodeRef><bpmn:flowNodeRef>N_search</bpmn:flowNodeRef><bpmn:flowNodeRef>N_available</bpmn:flowNodeRef><bpmn:flowNodeRef>N_confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>N_end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Координация"><bpmn:flowNodeRef>N_later</bpmn:flowNodeRef><bpmn:flowNodeRef>N_lost</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="N_start" name="Слот отменён"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="N_list" name="Обновить список отмен"><bpmn:incoming>F_0</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="N_notice" name="Найти отмену в списке"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="N_search" name="Искать свободный слот"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="N_available" name="Есть слот?"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="N_confirm" name="Связаться с пациентом"><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="N_end" name="Исход зафиксирован"><bpmn:incoming>F_5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="N_later" name="Отложить обращение"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="N_lost" name="Ожидает обработки"><bpmn:incoming>F_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_0" sourceRef="N_start" targetRef="N_list"/><bpmn:sequenceFlow id="F_1" sourceRef="N_list" targetRef="N_notice"/><bpmn:sequenceFlow id="F_2" sourceRef="N_notice" targetRef="N_search"/><bpmn:sequenceFlow id="F_3" sourceRef="N_search" targetRef="N_available"/><bpmn:sequenceFlow id="F_4" sourceRef="N_available" targetRef="N_confirm" name="Да"/><bpmn:sequenceFlow id="F_5" sourceRef="N_confirm" targetRef="N_end"/><bpmn:sequenceFlow id="F_6" sourceRef="N_available" targetRef="N_later" name="Нет"/><bpmn:sequenceFlow id="F_7" sourceRef="N_later" targetRef="N_lost"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="DL_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="0" y="0" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DL_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="0" y="90" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DL_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="0" y="180" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_start" bpmnElement="N_start"><dc:Bounds x="152" y="32" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_list" bpmnElement="N_list"><dc:Bounds x="250" y="19" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_notice" bpmnElement="N_notice"><dc:Bounds x="250" y="109" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_search" bpmnElement="N_search"><dc:Bounds x="400" y="109" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_available" bpmnElement="N_available"><dc:Bounds x="589" y="114" width="42" height="42"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_confirm" bpmnElement="N_confirm"><dc:Bounds x="705" y="109" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_end" bpmnElement="N_end"><dc:Bounds x="917" y="122" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_later" bpmnElement="N_later"><dc:Bounds x="705" y="199" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_lost" bpmnElement="N_lost"><dc:Bounds x="917" y="212" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DF_0" bpmnElement="F_0"><di:waypoint x="178" y="45"/><di:waypoint x="250" y="45"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_1" bpmnElement="F_1"><di:waypoint x="315" y="71"/><di:waypoint x="315" y="109"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_2" bpmnElement="F_2"><di:waypoint x="380" y="135"/><di:waypoint x="400" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_3" bpmnElement="F_3"><di:waypoint x="530" y="135"/><di:waypoint x="589" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_4" bpmnElement="F_4"><di:waypoint x="631" y="135"/><di:waypoint x="705" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_5" bpmnElement="F_5"><di:waypoint x="835" y="135"/><di:waypoint x="917" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_6" bpmnElement="F_6"><di:waypoint x="610" y="156"/><di:waypoint x="610" y="225"/><di:waypoint x="705" y="225"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_7" bpmnElement="F_7"><di:waypoint x="835" y="225"/><di:waypoint x="917" y="225"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>