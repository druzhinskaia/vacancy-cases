<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="https://druzhinskaia.github.io/medtech"><bpmn:process id="Process" name="tobe" isExecutable="false"><bpmn:laneSet id="Lanes"><bpmn:lane id="Lane_0" name="Расписание"><bpmn:flowNodeRef>N_start</bpmn:flowNodeRef><bpmn:flowNodeRef>N_dispatch</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Контакт-центр"><bpmn:flowNodeRef>N_search</bpmn:flowNodeRef><bpmn:flowNodeRef>N_timer</bpmn:flowNodeRef><bpmn:flowNodeRef>N_accepted</bpmn:flowNodeRef><bpmn:flowNodeRef>N_book</bpmn:flowNodeRef><bpmn:flowNodeRef>N_done</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Координация"><bpmn:flowNodeRef>N_review</bpmn:flowNodeRef><bpmn:flowNodeRef>N_closed</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="N_start" name="Слот отменён"><bpmn:outgoing>F_0</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="N_dispatch" name="Создать задачу в CRM"><bpmn:incoming>F_0</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="N_search" name="Проверить слот и связаться"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="N_timer" name="30 мин" attachedToRef="N_search"><bpmn:outgoing>F_6</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="N_accepted" name="Перенос согласован?"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="N_book" name="Подтвердить новую запись"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="N_done" name="Запись перенесена"><bpmn:incoming>F_4</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="N_review" name="Разобрать задачу и записать исход"><bpmn:incoming>F_5</bpmn:incoming><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="N_closed" name="Исход зафиксирован"><bpmn:incoming>F_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_0" sourceRef="N_start" targetRef="N_dispatch"/><bpmn:sequenceFlow id="F_1" sourceRef="N_dispatch" targetRef="N_search"/><bpmn:sequenceFlow id="F_2" sourceRef="N_search" targetRef="N_accepted"/><bpmn:sequenceFlow id="F_3" sourceRef="N_accepted" targetRef="N_book" name="Да"/><bpmn:sequenceFlow id="F_4" sourceRef="N_book" targetRef="N_done"/><bpmn:sequenceFlow id="F_5" sourceRef="N_accepted" targetRef="N_review" name="Нет"/><bpmn:sequenceFlow id="F_6" sourceRef="N_timer" targetRef="N_review"/><bpmn:sequenceFlow id="F_7" sourceRef="N_review" targetRef="N_closed"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="DL_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="0" y="0" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DL_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="0" y="90" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DL_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="0" y="180" width="1050" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_start" bpmnElement="N_start"><dc:Bounds x="152" y="32" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_dispatch" bpmnElement="N_dispatch"><dc:Bounds x="250" y="19" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_search" bpmnElement="N_search"><dc:Bounds x="250" y="109" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_timer" bpmnElement="N_timer"><dc:Bounds x="341" y="151" width="20" height="20"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_accepted" bpmnElement="N_accepted"><dc:Bounds x="484" y="114" width="42" height="42"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_book" bpmnElement="N_book"><dc:Bounds x="625" y="109" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_done" bpmnElement="N_done"><dc:Bounds x="902" y="122" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_review" bpmnElement="N_review"><dc:Bounds x="625" y="199" width="130" height="52"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DN_closed" bpmnElement="N_closed"><dc:Bounds x="902" y="212" width="26" height="26"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DF_0" bpmnElement="F_0"><di:waypoint x="178" y="45"/><di:waypoint x="250" y="45"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_1" bpmnElement="F_1"><di:waypoint x="315" y="71"/><di:waypoint x="315" y="109"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_2" bpmnElement="F_2"><di:waypoint x="380" y="135"/><di:waypoint x="484" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_3" bpmnElement="F_3"><di:waypoint x="526" y="135"/><di:waypoint x="625" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_4" bpmnElement="F_4"><di:waypoint x="755" y="135"/><di:waypoint x="902" y="135"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_5" bpmnElement="F_5"><di:waypoint x="505" y="156"/><di:waypoint x="505" y="225"/><di:waypoint x="625" y="225"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_6" bpmnElement="F_6"><di:waypoint x="351" y="171"/><di:waypoint x="351" y="225"/><di:waypoint x="625" y="225"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DF_7" bpmnElement="F_7"><di:waypoint x="755" y="225"/><di:waypoint x="902" y="225"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>